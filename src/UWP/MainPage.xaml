<Page
    x:Class="XBConverterUWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XBConverterUWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0D0D0D"
    KeyDown="OnPageKeyDown">

    <Grid Background="#0D0D0D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="25,16,25,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/Square44x44Logo.png" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="XB converter" FontSize="26" FontWeight="Bold" Foreground="#00C853" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Border Background="#1E1E1E" CornerRadius="4" Padding="8,3,8,3" VerticalAlignment="Center" BorderBrush="#333333" BorderThickness="1">
                        <TextBlock Text="Xbox DevMode v1.0.0" FontSize="12" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="By Hbolt" FontSize="13" Foreground="#888888" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Margin="25,15,25,10" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- 1. Input and Output Paths -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input Card -->
                    <Border Grid.Column="0" BorderBrush="#262626" BorderThickness="1" Padding="16" CornerRadius="6" Background="#161616">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Input Image / File:" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtInputFile" Grid.Column="0" IsReadOnly="True" PlaceholderText="No file selected..." Background="#222222" Foreground="#F0F0F0" BorderBrush="#333333" Height="36" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnSelectInput" Grid.Column="1" Content="Browse" Click="BtnSelectInput_Click" Background="#2E2E2E" Foreground="#FFFFFF" Margin="8,0,0,0" Height="36" MinWidth="90" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Output Card -->
                    <Border Grid.Column="2" BorderBrush="#262626" BorderThickness="1" Padding="16" CornerRadius="6" Background="#161616">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Output Directory:" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtOutputDir" Grid.Column="0" IsReadOnly="True" PlaceholderText="Same as input folder (default)..." Background="#222222" Foreground="#F0F0F0" BorderBrush="#333333" Height="36" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnSelectOutput" Grid.Column="1" Content="Browse" Click="BtnSelectOutput_Click" Background="#2E2E2E" Foreground="#FFFFFF" Margin="8,0,0,0" Height="36" MinWidth="90" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Settings Grid (Formats, Scrubbing, Modifiers) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Output Format Card -->
                    <Border Grid.Column="0" BorderBrush="#262626" BorderThickness="1" Padding="16" CornerRadius="6" Background="#161616">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Output Format:" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0" />
                            <ComboBox x:Name="CmbOutputFormat" SelectedIndex="0" HorizontalAlignment="Stretch" Background="#222222" Foreground="#F0F0F0" BorderBrush="#333333">
                                <ComboBoxItem Content="Extract (Directory)" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="XISO (Xbox ISO)" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="Games on Demand (GoD)" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="CCI Archive" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="CSO Archive" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="ZAR Archive" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="OG Xbox (Auto)" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="Xbox 360 (Auto)" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="Xemu (Auto)" Foreground="#F0F0F0" />
                                <ComboBoxItem Content="Xenia (Auto)" Foreground="#F0F0F0" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Scrub Card -->
                    <Border Grid.Column="2" BorderBrush="#262626" BorderThickness="1" Padding="16" CornerRadius="6" Background="#161616">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Scrub:" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0" />
                            <RadioButton x:Name="RadScrubNone" GroupName="ScrubGroup" Content="None" IsChecked="True" Foreground="#C8C8C8"/>
                            <RadioButton x:Name="RadScrubPartial" GroupName="ScrubGroup" Content="Partial" Foreground="#C8C8C8"/>
                            <RadioButton x:Name="RadScrubFull" GroupName="ScrubGroup" Content="Full" Foreground="#C8C8C8"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings Checkboxes Card -->
                    <Border Grid.Column="4" BorderBrush="#262626" BorderThickness="1" Padding="16" CornerRadius="6" Background="#161616">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Settings:" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0" />
                            <CheckBox x:Name="ChkSplitXiso" Content="Split XISO" Foreground="#C8C8C8"/>
                            <CheckBox x:Name="ChkAttachXbe" Content="Generate Attach XBE" Foreground="#C8C8C8"/>
                            <CheckBox x:Name="ChkAllowedMedia" Content="Allowed Media XBE Patch" Foreground="#C8C8C8"/>
                            <CheckBox x:Name="ChkRenameXbe" Content="Rename XBE Title" Foreground="#C8C8C8"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Status Bar & Actions -->
                <Border BorderBrush="#262626" BorderThickness="1" Padding="16" CornerRadius="6" Background="#161616">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status text & Progress Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status: " FontSize="14" FontWeight="SemiBold" Foreground="#888888" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Idle" FontSize="14" FontWeight="Bold" Foreground="#00C853" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>

                        <ProgressBar x:Name="ProgBar" Grid.Row="1" Height="8" IsIndeterminate="False" Value="0" Maximum="100" Margin="0,0,0,15" Foreground="#00C853" Background="#262626"/>

                        <!-- Action Buttons -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnConvert" Grid.Column="0" Content="Process All [Y]" Click="BtnConvert_Click" HorizontalAlignment="Stretch" Height="44" FontSize="16" FontWeight="Bold" Background="#00A032" Foreground="#FFFFFF" CornerRadius="4"/>
                            <Button x:Name="BtnReset" Grid.Column="2" Content="Reset [X]" Click="BtnReset_Click" HorizontalAlignment="Stretch" Height="44" FontSize="14" FontWeight="SemiBold" Background="#2E2E2E" Foreground="#FFFFFF" CornerRadius="4"/>
                            <Button x:Name="BtnPause" Grid.Column="4" Content="Pause" Click="BtnPause_Click" IsEnabled="False" HorizontalAlignment="Stretch" Height="44" FontSize="14" FontWeight="SemiBold" Background="#2E2E2E" Foreground="#FFFFFF" CornerRadius="4"/>
                            <Button x:Name="BtnCancel" Grid.Column="6" Content="Cancel" Click="BtnCancel_Click" IsEnabled="False" HorizontalAlignment="Stretch" Height="44" FontSize="14" FontWeight="SemiBold" Background="#2E2E2E" Foreground="#FFFFFF" CornerRadius="4"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 4. Console Log -->
                <Border BorderBrush="#262626" BorderThickness="1" Padding="12" CornerRadius="6" Background="#0A0A0A">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Console Output:" FontSize="13" FontWeight="SemiBold" Foreground="#888888"/>
                        <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" Text="Ready." Foreground="#00C853" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="4"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Controller Guide Bar & Footer -->
        <Border Grid.Row="2" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="25,10,25,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Gamepad Shortcuts Legend -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#FFD600" CornerRadius="10" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Y" Foreground="#000000" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Start Process" Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#0091EA" CornerRadius="10" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="X" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Refresh / Reset" Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#555555" CornerRadius="10" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="RS" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Scroll View" Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Author & Github Footer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="v1.0.0 | By Hbolt | Github: " Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                    <HyperlinkButton Content="ibmk15uchiha-dev/XGDTool" NavigateUri="https://github.com/ibmk15uchiha-dev/XGDTool" Foreground="#00C853" FontSize="12" Padding="0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
